<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- Freeway car-following test for profaccradar, generated by
       grading/groupCreation/tools/make_group_docker.py from profacc/launch/profaccradar.launch
       (and the shared chain of profacc/launch/profaccradar.launch).
       Do not edit by hand; re-run it.

       The lead car replays /car/state/vel_x (and the ACC set speed) from
       2026_10_23_16_53_49_2T3MWRFVXLW056972profaccradar.bag
       starting where the car entered the freeway (520.19 s into the bag) for
       120 s, starting at 17.91 m/s with the bag's 54 m gap. The ego runs the
       on-car chain: controller -> speedlimiter -> multimodecbf, with the
       20 m offset, in the root namespace exactly as on the car.

       Run from rossim/:  ./scripts/run.sh profacc profaccradarDocker_freeway.launch
       Output: $(arg bagfileout).bag -->

  <arg name="bag" default="/ros/catkin_ws/2026_10_23_16_53_49_2T3MWRFVXLW056972profaccradar.bag"/>
  <arg name="start" default="520.19"/>
  <arg name="duration" default="120"/>
  <arg name="v0" default="17.91"/>
  <!-- seconds the chain settles on the starting condition before the ego plant starts -->
  <arg name="preroll" default="5"/>
  <arg name="bagfileout" default="/ros/catkin_ws/freeway_results/profaccradar"/>

  <!-- ~~~~~ Controller section, verbatim from profacc/launch/profaccradar.launch ~~~~~ -->
  <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
  <!-- ~~~~ Your team may add params but should not change any of the remaps below ~~~ -->
  <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

    <!-- your description likely should not change, but if it needs to , check it here -->
    <arg name="description" default="profaccradar"/>
    <!-- if you have parameters for your node, set them here, OUTSIDE the node tag.
         Simulink-generated nodes look parameters up from the root namespace
         (/alpha), so a param inside <node> (which becomes /profacc/alpha) is
         never read and the node silently uses its compiled-in default. -->
    <param name="alpha" type="double" value="1.1" />
    <param name="tau" type="double" value="2" />
    <param name="lambda" type="double" value="0.1" />
    <!-- Your package name should not change -->
    <node pkg="profacc" type="profacc" name="profacc" output="screen">
        <!-- DO NOT change this remap; this is a hardware-only configuration -->
        <remap from="cmd_accel" to="cmd_accel_speedlimit_pre"/>
        <!-- DO NOT change this remap; this gives an additional safety buffer -->
        <remap from="lead_dist" to="lead_dist_extra"/>
    </node>

  <!-- ~~~~~ Shared chain, verbatim from profaccradar.launch ~~~~~ -->

    <!-- ~~~~~ Set a speed limit for the car from the ACC set speed in m/s~~~~~~~~~~~~~~ -->
    <!-- buffer for the speed limit (root namespace: speedlimiter is Simulink-generated) -->
    <param name="buffer" type="double" value="1.0" />
    <node pkg="speedlimiter" type="speedlimiter" name="speedlimiter">
        <!-- take the output from the controller and feed it into the speed limiter -->
        <remap from="cmd_accel_pre" to="cmd_accel_speedlimit_pre"/>
        <remap from="cmd_accel_limited" to="cmd_accel_pre"/>
    </node>


    <!-- ~~~~~ Pretend we are 20m closer to the car in front than we actually are,
	           in order to avoid using the CBF the whole time ~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
    <!-- We want an offset of (say) 10m for lead_dist -->
    <arg name="offset_rate" default="10.0"/>
    <arg name="offset_value" default="20.0"/>
    <node pkg="rostopic" type="rostopic" name="rostopic_offset" 
        args="pub lead_dist_offset -r $(arg offset_rate) std_msgs/Float64 'data: $(arg offset_value)'"/>
    
    <!-- ~~~~~ Radar-based space gap: estimate the lead distance from the radar
               tracks, then choose between it and lead_dist ~~~~~~~~~~~~~~~~~~~~~~ -->
    <!-- (radar estimator leadVelProcessing.py omitted: no radar in sim) -->
    <!-- lead_dist_radar = radar estimate when it is valid, fresh, and the lead is
         at least min_radar_dist away; lead_dist otherwise -->
    <node pkg="profacc" type="radar_gap_select.py" name="radar_gap_select" output="screen">
        <param name="min_radar_dist" type="double" value="10.0" />
        <param name="max_age" type="double" value="0.25" />
    </node>

    <!-- Fake the extra space for the chosen gap -->
    <node pkg="subtractor" type="subtractor" name="subtractor_extra_space">
        <remap from="in1" to="lead_dist_radar" />
        <remap from="in2" to="lead_dist_offset" />
        <remap from="diff" to="lead_dist_extra_raw" />
    </node>

    <node pkg="topic_tools" type="transform" name="lead_dist_floor"
           args="lead_dist_extra_raw lead_dist_extra std_msgs/Float64 'max(2.914, m.data)'" />

    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
    <!-- ~~  Safety and supervisory control parameters of the Control Barrier Function ~ -->
    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

    <!-- CBF params -->
    <arg name="margin" default="30.0"/>
    <arg name="use_margin" default="false"/>
    <arg name="hwil" default="true"/>
    <arg name="readonly" default="false"/>
    <arg name="vsl_hwil_test" default="false"/>
    <!-- old CBF node
    <node pkg="cbf" type="cbf" name="cbf" if="$(eval not readonly and hwil)">
    </node>
    -->
    
    
    <!-- root namespace: multimodecbf is Simulink-generated. Before 2026-10-28 these
         were inside the node tag and never read (compiled defaults: 0.1 and 0.0). -->
    <param name="creep_velocity_limit" type="double" value="0.1" />
    <param name="creep_acceleration_limit" type="double" value="0.05" />
    <!-- jmscslgroup/multimodecbf (see libpanda-apps.yaml); replaces katesanborn/multimodalcbf -->
    <node pkg="multimodecbf" type="multimodecbf" name="multimodecbf" if="$(eval not readonly and hwil)">
        <!-- DO NOT change this remap; this fixes the sign change for rel_vel -->
        <!-- <remap from="rel_vel" to="rel_vel_reversed"/> -->
    </node>


  <!-- ~~~~~ Simulated car and lead, replacing the car's CAN interface ~~~~~ -->
  <!-- ego plant; reads /v0, /x0, /L (root namespace, Simulink-generated).
       It waits until lead_from_bag has loaded the bag and is speaking for it,
       then $(arg preroll) s more so the chain settles on the starting condition. -->
  <param name="v0" type="double" value="$(arg v0)" />
  <param name="x0" type="double" value="0.0" />
  <param name="L" type="double" value="4.0" />
  <node pkg="carcomplexsimulink" type="carcomplexsimulink" name="carcomplexsimulink"
        launch-prefix="bash -c 'until rosparam get /lead_from_bag/ready >/dev/null 2>&amp;1; do sleep 0.2; done; sleep $(arg preroll); $0 $@'">
    <remap from="vel_x" to="car/state/vel_x" />
  </node>

  <!-- lead car from the bag, and the car's radar (lead_dist = bumper gap,
       rel_vel = v_lead - v_ego), in lock-step with the plant; it ends the
       simulation when the window is done -->
  <node pkg="profacc" type="lead_from_bag.py" name="lead_from_bag" output="screen" required="true">
    <param name="bag" value="$(arg bag)" />
    <param name="start" type="double" value="$(arg start)" />
    <param name="duration" type="double" value="$(arg duration)" />
    <param name="v0" type="double" value="$(arg v0)" />
  </node>

  <node pkg="rosbag" type="record" name="rosbag_recorder"
        args="-O $(arg bagfileout)
              /leadcar/car/state/vel_x /leadcar/odom_x /car/state/vel_x /front_x
              /lead_dist /rel_vel /lead_dist_radar /lead_dist_extra /acc/set_speed
              /cmd_accel_speedlimit_pre /cmd_accel_pre /cmd_accel
              /multimodecbf_debug/cbf_acc /multimodecbf_debug/cbf_active /multimodecbf_debug/cbf_mode" />
</launch>
